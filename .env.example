# GEMINI_API_KEY: Used for Gemini AI API calls (primary engine for Bhupendra AI).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional alternative OpenAI API key for Bhupendra AI.
OPENAI_API_KEY=""

# ADMIN_PASSCODE: Passcode to access Content Management Admin Panel (Default: bhupendra2026)
ADMIN_PASSCODE="bhupendra2026"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
